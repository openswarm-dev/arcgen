HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
PORT=3001

# Supabase — arcgen project (nbuanplvfreoascjstbl)
SUPABASE_URL=https://nbuanplvfreoascjstbl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend (https://resend.com/api-keys) — used to email 6-digit verification PINs
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Insta <beth.t@example.com>

# Optional: live source fetching. Handles still save without these.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
FOMO_API_KEY=

# OpenRouter (https://openrouter.ai/settings/keys) — simple single-image generations
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_VIDEO_MODEL=alibaba/wan-3.0
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=ArcGen

# Atlas Cloud (https://atlascloud.ai) — character swap presets (Wan 3.0 reference-to-video)
ATLASCLOUD_API_KEY=apikey-your_key_here
ATLASCLOUD_VIDEO_MODEL=alibaba/wan-3.0/reference-to-video

# Public URL OpenRouter uses to fetch reference media (falls back to RENDER_EXTERNAL_URL on Render)
PUBLIC_API_URL=http://localhost:3001
