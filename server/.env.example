HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
PORT=3001

# Supabase — social app project (aevyflsboufozdpnidgv)
SUPABASE_URL=https://aevyflsboufozdpnidgv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend (https://resend.com/api-keys) — used to email 6-digit verification PINs
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Insta <beth.t@example.com>

# Optional: live source fetching. Handles still save without these.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
FOMO_API_KEY=

# OpenRouter (https://openrouter.ai/settings/keys) — simple single-image generations
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_VIDEO_MODEL=alibaba/wan-3.0
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=ArcGen

# DashScope (https://www.alibabacloud.com/help/en/model-studio/get-api-key) — video + dual-image swap
DASHSCOPE_API_KEY=sk-your_dashscope_key_here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_VIDEO_MODEL=wan3.0-video

# Public URL Wan providers use to fetch reference media (required outside localhost)
PUBLIC_API_URL=http://localhost:3001
